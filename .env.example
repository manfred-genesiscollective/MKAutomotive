# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Public address of the site, without a trailing slash.
# Vercel detects the production domain automatically, so this is only needed elsewhere.
NEXT_PUBLIC_SITE_URL=

# Enquiry forms send email through Resend (https://resend.com).
# Until all three are set, submissions are not delivered:
# in development they are logged to the terminal instead, and on a live
# deployment the visitor is told the message could not be sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. MK Automotive Group <website@example.sg>
ENQUIRY_FROM_EMAIL=
# Where enquiries are delivered. Separate several addresses with commas.
ENQUIRY_TO_EMAIL=
